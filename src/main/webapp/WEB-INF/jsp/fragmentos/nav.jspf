<%@ page import="org.iesbelen.model.Usuario" %>
<%
    Usuario usuarioNav = (Usuario) session.getAttribute("usuario-logado");
    boolean esAdmin = usuarioNav != null && "admin".equalsIgnoreCase(usuarioNav.getRol());
%>
<nav class="menu">
    <a href="<%=application.getContextPath()%>/">Tienda</a>



    <% if (esAdmin) { %>
    <a href="<%=application.getContextPath()%>/tienda/usuarios">Usuarios</a>
    <a href="<%=application.getContextPath()%>/tienda/productos">Productos</a>

    <% } %>


    <% if (usuarioNav != null) { %>
    <a href="<%=application.getContextPath()%>/tienda/carrito">Carrito</a>
    <a href="<%=application.getContextPath()%>/tienda/pedidos">Detalle Pedidos</a>

    <% } %>

    <!-- Login/Logout -->
    <div class="menu-log">
        <% if (usuarioNav != null) { %>
        <p>Hola, <%= usuarioNav.getNombre() %>
            <% if (esAdmin) { %><strong>(Admin)</strong><% } %>
        </p>
        <a href="<%=application.getContextPath()%>/tienda/usuarios/logout">LOGOUT</a>
        <% } else { %>
        <a href="<%=application.getContextPath()%>/tienda/usuarios/login">LOGIN</a>
        <% } %>
    </div>
</nav>